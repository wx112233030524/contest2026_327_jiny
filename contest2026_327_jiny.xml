<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.

    FOCPilot (team 327):
      app/focscope/ -> apps/examples/focscope
        The app is self-contained (Kconfig + Make.defs + Makefile). The apps
        repo picks it up automatically: apps/examples/Make.defs does
        `include $(wildcard $(APPDIR)/examples/*/Make.defs)` and
        apps/examples/Kconfig is autogenerated by apps/tools/mkkconfig.sh.
        No file in the apps repo is modified.

      board/r528s3_config/defconfig is NOT linked - build.sh accepts an
      arbitrary path for the board config, so build with:
        ./build.sh contest2026_327_jiny/board/r528s3_config
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_327_jiny" name="contest2026_327_jiny">
    <linkfile src="app/focscope" dest="apps/examples/focscope"/>
  </project>
</manifest>
